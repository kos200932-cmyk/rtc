# SolidWorks files are generated by the macros from the specs
*.SLDPRT
*.SLDASM
*.SLDDRW
*.sldprt
*.sldasm
*.slddrw
~$*
__pycache__/

# CalculiX working files (tools/fea_ccx.py) - only the summary is kept
fea/RTC-7/ccx/*.inp
fea/RTC-7/ccx/*.frd
fea/RTC-7/ccx/*.dat
fea/RTC-7/ccx/*.sta
fea/RTC-7/ccx/*.cvg
fea/RTC-7/ccx/*.12d
fea/RTC-7/ccx/spooles.out
# Ansys results written next to rtc7_fea.json
fea/RTC-7/results_*.csv
fea/RTC-7/log_*.txt
fea/RTC-7/ccx/summary.json
fea/RTC-7/ccx/vtu/
